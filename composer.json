{
  "name": "optisistem/freimguork-core",
  "description": "Core module for Freimguork projects",
  "authors": [
    {
      "name": "Barbara Gavalda",
      "email": "bgb@optisistem.com"
    },
    {
      "name": "Toni Palanques",
      "email": "tpv@optisistem.com"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "git@bitbucket.org:optisistem/php-ref.git"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-curl": "*",
    "ext-exif": "*",
    "ext-gettext": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "twig/twig": "^3.0",
    "jblond/twig-trans": "^1.2",
    "phpmailer/phpmailer": "^7.1",
    "simplesoftwareio/simple-qrcode": "^4.2",
    "phpoffice/phpspreadsheet": "^5.8",
    "firebase/php-jwt": "^7.1",
    "google/apiclient": "^2.19",
    "guzzlehttp/psr7": "^2.0",
    "psr/container": "^1.1 || ^2.0",
    "psr/http-message": "^1.0 || ^2.0",
    "optisistem/php-ref": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "jetbrains/phpstorm-attributes": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Core\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "check-constraints": "php bin/check-sibling-constraints.php"
  },
  "minimum-stability": "dev"
}
